<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inject customs fields into the vendor bill form -->
        <record id="view_account_move_customs_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit.advance_landed_cost</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!--
                    Add customs classification fields after the existing
                    'ref' (internal reference) field in the bill header area.
                -->
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="customs_bill_type"
                           invisible="not customs_landed_cost_id and not customs_bill_type"/>
                    <field name="customs_landed_cost_id"
                           invisible="not customs_landed_cost_id and not customs_bill_type"
                           readonly="customs_bill_type != False"/>
                </xpath>
            </field>
        </record>

        <!-- List view addition: show customs bill type in vendor bills list -->
        <record id="view_account_move_tree_customs_inherit" model="ir.ui.view">
            <field name="name">account.move.list.inherit.advance_landed_cost</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="customs_bill_type" optional="hide"/>
                    <field name="customs_landed_cost_id" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
