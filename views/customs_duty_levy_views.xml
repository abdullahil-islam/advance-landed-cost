<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List view -->
        <record id="view_customs_duty_levy_list" model="ir.ui.view">
            <field name="name">customs.duty.levy.list</field>
            <field name="model">customs.duty.levy</field>
            <field name="arch" type="xml">
                <list string="Levy Types">
                    <field name="name"/>
                    <field name="levy_type"/>
                    <field name="rate" string="Rate (%)"/>
                    <field name="include_in_vat_base"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_customs_duty_levy_form" model="ir.ui.view">
            <field name="name">customs.duty.levy.form</field>
            <field name="model">customs.duty.levy</field>
            <field name="arch" type="xml">
                <form string="Levy Type">
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Standard VAT"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="levy_type"/>
                                <field name="rate" string="Rate (%)"/>
                                <field name="include_in_vat_base"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_customs_duty_levy_search" model="ir.ui.view">
            <field name="name">customs.duty.levy.search</field>
            <field name="model">customs.duty.levy</field>
            <field name="arch" type="xml">
                <search string="Search Levy Types">
                    <field name="name"/>
                    <field name="levy_type"/>
                    <filter string="Active" name="active"
                            domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive"
                            domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="VAT" name="filter_vat"
                            domain="[('levy_type', '=', 'vat')]"/>
                    <filter string="CESS" name="filter_cess"
                            domain="[('levy_type', '=', 'cess')]"/>
                    <filter string="SSCL" name="filter_sscl"
                            domain="[('levy_type', '=', 'sscl')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_type" string="Levy Type"
                                context="{'group_by': 'levy_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Window action -->
        <record id="action_customs_duty_levy" model="ir.actions.act_window">
            <field name="name">Levy Types</field>
            <field name="res_model">customs.duty.levy</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Levy Type
                </p>
                <p>
                    Define the levies your company collects — VAT, CESS, SSCL, or
                    any custom levy required by your country's customs regulations.
                </p>
            </field>
        </record>

    </data>
</odoo>
