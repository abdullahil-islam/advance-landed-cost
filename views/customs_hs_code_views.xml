<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List view -->
        <record id="view_customs_hs_code_list" model="ir.ui.view">
            <field name="name">customs.hs.code.list</field>
            <field name="model">customs.hs.code</field>
            <field name="arch" type="xml">
                <list string="HS Codes">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_customs_hs_code_form" model="ir.ui.view">
            <field name="name">customs.hs.code.form</field>
            <field name="model">customs.hs.code</field>
            <field name="arch" type="xml">
                <form string="HS Code">
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="e.g. 7208.10"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Describe the goods this HS code covers..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_customs_hs_code_search" model="ir.ui.view">
            <field name="name">customs.hs.code.search</field>
            <field name="model">customs.hs.code</field>
            <field name="arch" type="xml">
                <search string="Search HS Codes">
                    <field name="name" string="HS Code"/>
                    <field name="description"/>
                    <filter string="Active" name="active"
                            domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive"
                            domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Global (All Companies)" name="global"
                            domain="[('company_id', '=', False)]"
                            groups="base.group_multi_company"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_company" string="Company"
                                context="{'group_by': 'company_id'}"
                                groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Window action -->
        <record id="action_customs_hs_code" model="ir.actions.act_window">
            <field name="name">HS Codes</field>
            <field name="res_model">customs.hs.code</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first HS Code
                </p>
                <p>
                    Harmonised System codes classify products for customs duties.
                    Assign them to products directly or to product categories for
                    bulk classification.
                </p>
            </field>
        </record>

    </data>
</odoo>
