<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Demo HS Codes (global) ─────────────────────────────────────── -->

        <record id="hs_code_steel_flat_rolled" model="customs.hs.code">
            <field name="name">7208.10</field>
            <field name="description">Flat-rolled products of iron or non-alloy steel, hot-rolled, in coils</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hs_code_electronic_circuits" model="customs.hs.code">
            <field name="name">8542.31</field>
            <field name="description">Electronic integrated circuits — processors and controllers</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hs_code_cotton_fabric" model="customs.hs.code">
            <field name="name">5208.11</field>
            <field name="description">Woven fabrics of cotton, unbleached, plain weave, ≤100 g/m²</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hs_code_plastic_granules" model="customs.hs.code">
            <field name="name">3901.10</field>
            <field name="description">Polyethylene having a specific gravity of less than 0.94, in primary forms</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hs_code_passenger_vehicles" model="customs.hs.code">
            <field name="name">8703.23</field>
            <field name="description">Motor cars with spark-ignition engine, cylinder capacity 1,500–3,000 cc</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ── Demo Trade Region (global) ────────────────────────────────── -->

        <record id="duty_region_eu" model="customs.duty.region">
            <field name="name">European Union</field>
            <field name="code">EU</field>
            <field name="country_ids" eval="[
                (4, ref('base.de')),
                (4, ref('base.fr')),
                (4, ref('base.it')),
                (4, ref('base.es')),
                (4, ref('base.nl')),
                (4, ref('base.be')),
                (4, ref('base.at')),
                (4, ref('base.pl')),
                (4, ref('base.se')),
                (4, ref('base.dk')),
            ]"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="duty_region_asean" model="customs.duty.region">
            <field name="name">ASEAN</field>
            <field name="code">ASEAN</field>
            <field name="country_ids" eval="[
                (4, ref('base.sg')),
                (4, ref('base.my')),
                (4, ref('base.th')),
                (4, ref('base.id')),
                (4, ref('base.vn')),
                (4, ref('base.ph')),
            ]"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ── Demo Levy Types (global) ──────────────────────────────────── -->

        <record id="levy_standard_vat" model="customs.duty.levy">
            <field name="name">Standard VAT</field>
            <field name="levy_type">vat</field>
            <field name="rate">20.0</field>
            <field name="include_in_vat_base" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="levy_standard_cess" model="customs.duty.levy">
            <field name="name">Standard CESS</field>
            <field name="levy_type">cess</field>
            <field name="rate">2.0</field>
            <field name="include_in_vat_base" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="levy_standard_sscl" model="customs.duty.levy">
            <field name="name">Standard SSCL</field>
            <field name="levy_type">sscl</field>
            <field name="rate">1.5</field>
            <field name="include_in_vat_base" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ── Demo Duty Rates (global) ──────────────────────────────────── -->

        <!-- Steel: Germany-specific rate -->
        <record id="duty_rate_steel_de" model="customs.duty.rate">
            <field name="hs_code_id" ref="hs_code_steel_flat_rolled"/>
            <field name="country_id" ref="base.de"/>
            <field name="date_from">2020-01-01</field>
            <field name="duty_rate">5.0</field>
            <field name="vat_rate">20.0</field>
            <field name="cess_rate">2.0</field>
            <field name="sscl_rate">1.5</field>
            <field name="notes">Standard rate for hot-rolled steel from Germany</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Electronics: EU region rate -->
        <record id="duty_rate_electronics_eu" model="customs.duty.rate">
            <field name="hs_code_id" ref="hs_code_electronic_circuits"/>
            <field name="region_id" ref="duty_region_eu"/>
            <field name="date_from">2020-01-01</field>
            <field name="duty_rate">0.0</field>
            <field name="vat_rate">20.0</field>
            <field name="cess_rate">0.0</field>
            <field name="sscl_rate">0.0</field>
            <field name="notes">Zero duty for EU-origin electronics (ITA agreement)</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Cotton fabric: global default rate -->
        <record id="duty_rate_cotton_global" model="customs.duty.rate">
            <field name="hs_code_id" ref="hs_code_cotton_fabric"/>
            <field name="date_from">2020-01-01</field>
            <field name="duty_rate">12.0</field>
            <field name="vat_rate">20.0</field>
            <field name="cess_rate">2.0</field>
            <field name="sscl_rate">1.5</field>
            <field name="notes">Global default rate for cotton woven fabric</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
